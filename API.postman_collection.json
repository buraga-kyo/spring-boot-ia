{
  "info": {
    "name": "BookStore API",
    "description": "CRUD de livros da API BookStore (Spring Boot 4). O resumo (review) e gerado por IA no momento da criacao.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "bookId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Book",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set('bookId', pm.response.json().id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"Dom Casmurro\",\n    \"author\": \"Machado de Assis\",\n    \"publisher\": \"Editora Garnier\",\n    \"publicationYear\": 1899\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        },
        "description": "Cria um livro. Retorna 201 com o livro salvo, incluindo o campo review gerado por IA."
      },
      "response": []
    },
    {
      "name": "Get All Books",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        },
        "description": "Lista todos os livros. Retorna 200."
      },
      "response": []
    },
    {
      "name": "Get One Book",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/{{bookId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "{{bookId}}"
          ]
        },
        "description": "Busca um livro pelo id (UUID). Retorna 200, ou 404 com 'Book not found.'"
      },
      "response": []
    },
    {
      "name": "Update Book",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"Dom Casmurro\",\n    \"author\": \"Machado de Assis\",\n    \"publisher\": \"Companhia das Letras\",\n    \"publicationYear\": 2016\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books/{{bookId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "{{bookId}}"
          ]
        },
        "description": "Atualiza um livro pelo id (UUID). Retorna 200, ou 404 com 'Book not found.'"
      },
      "response": []
    },
    {
      "name": "Delete Book",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/{{bookId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "{{bookId}}"
          ]
        },
        "description": "Remove um livro pelo id (UUID). Retorna 200, ou 404 com 'Book not found.'"
      },
      "response": []
    }
  ]
}